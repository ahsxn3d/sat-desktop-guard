// ==============================================================================
// THE ANTI-BURNOUT SAT RULEBOOK - PRISMA SCHEMA
// ==============================================================================
// Comprehensive database schema supporting all website features:
// - User & NextAuth authentication
// - 5-Tier Curriculum Hierarchy: Domain -> Course -> Unit -> Lesson -> Skill -> Question
// - User Mastery State Machine & High-Stakes Test Attempts
// - Study roadmap task completion & rollover state
// - Daily anchor time & timeline schedule settings
// - Daily journal notes & reflection
// - Comprehensive error log & mistake analysis
// - Session timer & pacing ratings (Math, Break, RW)
// - Bluebook official practice exam score tracking (Tests 1-6)
// - Exam day gear & packing checklist
// - Desmos & Reading/Writing cheat code bookmarks & mastery
// - Custom user-defined daily tasks
// - Admin system announcements & student monitoring
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum PacingRating {
  TOO_FAST
  PERFECT
  TOO_LATE
}

enum DomainType {
  MATH
  READING_WRITING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MasteryStatus {
  NOT_STARTED
  ATTEMPTED
  FAMILIAR
  PROFICIENT
  MASTERED
}

enum TestType {
  PRACTICE
  QUIZ
  UNIT_TEST
  DIAGNOSTIC
}

// ------------------------------------------------------------------------------
// USER & AUTHENTICATION (NextAuth Compatible)
// ------------------------------------------------------------------------------

model User {
  id                 String                  @id @default(cuid())
  name               String?
  email              String?                 @unique
  username           String?                 @unique
  passwordHash       String?
  emailVerified      DateTime?
  image              String?
  role               Role                    @default(USER)
  streakCount        Int                     @default(0)
  lastActiveDate     DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  accounts           Account[]
  sessions           Session[]
  progress           UserProgress?
  dayNotes           UserDayNote[]
  errorLogs          UserErrorLog[]
  sessionLogs        UserSessionLog[]
  customTasks        UserCustomTask[]
  packingItems       UserPackingItem[]
  cheatCodeBookmarks UserCheatCodeBookmark[]
  testScores         BluebookTestScore[]
  stuckConcepts      UserStuckConcept[]
  aiChatSessions     AIChatSession[]
  masteries          UserMastery[]
  testAttempts       TestAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------------------------
// 5-TIER CURRICULUM HIERARCHY & ASSESSMENT ENGINE
// Domain -> Course -> Unit -> Lesson -> Skill -> Question
// ------------------------------------------------------------------------------

model Domain {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     Course[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  domainId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  units       Unit[]

  @@index([domainId])
}

model Unit {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  skills    Skill[]

  @@index([unitId])
}

model Skill {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  lessonId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  masteries UserMastery[]

  @@index([lessonId])
}

model Question {
  id         String     @id @default(cuid())
  skillId    String
  prompt     String     @db.Text
  options    Json
  solution   String     @db.Text
  hints      String[]
  difficulty Difficulty @default(MEDIUM)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([difficulty])
}

model UserMastery {
  id        String        @id @default(cuid())
  userId    String
  skillId   String
  status    MasteryStatus @default(NOT_STARTED)
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@index([status])
}

model TestAttempt {
  id             String    @id @default(cuid())
  userId         String
  testType       TestType
  score          Float
  totalQuestions Int
  passed         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testType])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// USER OVERALL PROGRESS & SETTINGS
// ------------------------------------------------------------------------------

model UserProgress {
  id                    String   @id @default(cuid())
  userId                String   @unique
  completedTaskIds      Json     @default("{}")
  taskCompletionDays    Json?    @default("{}")
  taskScheduleOverrides Json?    @default("{}")
  packingList           Json?    @default("[]")
  anchorTime            String?  @default("20:30")
  targetScore           Int?     @default(1550)
  examDate              String?  @default("2026-11-07")
  lastActiveDate        String?
  diagnosticProfile     Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// DAILY NOTES & REFLECTION
// ------------------------------------------------------------------------------

model UserDayNote {
  id        String   @id @default(cuid())
  userId    String
  dateStr   String
  notes     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateStr])
  @@index([userId, dateStr])
}

// ------------------------------------------------------------------------------
// ERROR LOG & MISTAKE ANALYSIS
// ------------------------------------------------------------------------------

model UserErrorLog {
  id            String   @id @default(cuid())
  userId        String
  date          String?
  testOrSection String
  questionRef   String
  domain        String   @default("Math")
  whyMissed     String   @db.Text
  takeawayRule  String   @db.Text
  reviewed      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, domain])
  @@index([userId, reviewed])
}

// ------------------------------------------------------------------------------
// STUDY SESSION TIMING & PACING RATINGS
// ------------------------------------------------------------------------------

model UserSessionLog {
  id            String   @id @default(cuid())
  userId        String
  dateStr       String
  dayTitle      String?
  phase1Seconds Int      @default(0)
  breakSeconds  Int      @default(0)
  phase2Seconds Int      @default(0)
  totalSeconds  Int      @default(0)
  totalMinutes  Float    @default(0)
  overallRating String?
  details       Json?
  completedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateStr])
  @@index([userId, dateStr])
}

// ------------------------------------------------------------------------------
// EXAM GEAR & PACKING CHECKLIST
// ------------------------------------------------------------------------------

model UserPackingItem {
  id        String   @id @default(cuid())
  userId    String
  item      String
  category  String   @default("essential")
  required  Boolean  @default(false)
  packed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

// ------------------------------------------------------------------------------
// DESMOS & READING/WRITING CHEAT CODE BOOKMARKS & MASTERY
// ------------------------------------------------------------------------------

model UserCheatCodeBookmark {
  id          String   @id @default(cuid())
  userId      String
  cheatCodeId String
  bookmarked  Boolean  @default(true)
  mastered    Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cheatCodeId])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// BLUEBOOK OFFICIAL PRACTICE TEST SCORE TRACKER
// ------------------------------------------------------------------------------

model BluebookTestScore {
  id          String   @id @default(cuid())
  userId      String
  testNumber  Int
  testName    String
  dateTaken   String
  mathScore   Int?
  rwScore     Int?
  totalScore  Int?
  notes       String?  @db.Text
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, testNumber])
  @@index([userId])
}

// ------------------------------------------------------------------------------
// USER CUSTOM TASKS (Per-Day Personalized Tasks)
// ------------------------------------------------------------------------------

model UserCustomTask {
  id        String   @id @default(cuid())
  userId    String
  dateStr   String
  label     String
  subject   String   @default("review")
  code      String?
  topic     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateStr])
}

// ------------------------------------------------------------------------------
// SYSTEM ANNOUNCEMENTS & ADMIN BROADCASTS
// ------------------------------------------------------------------------------

model SystemAnnouncement {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  priority    String   @default("normal")
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------------------------------
// STUCK CONCEPTS & STRUGGLE TRACKER (Linked with Core Info & Calendar)
// ------------------------------------------------------------------------------

model UserStuckConcept {
  id             String   @id @default(cuid())
  userId         String
  dateStr        String
  dayNumber      Int?
  lessonCode     String
  lessonTitle    String
  chapter        String
  conceptFormula String
  notes          String   @db.Text
  takeawayRule   String?  @db.Text
  resolved       Boolean  @default(false)
  errorLogId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateStr])
  @@index([userId, chapter])
  @@index([userId, resolved])
}

// ------------------------------------------------------------------------------
// AI ASSISTANT & CHAT SESSIONS (Gemini Co-Pilot)
// ------------------------------------------------------------------------------

model AIChatSession {
  id        String          @id @default(cuid())
  userId    String
  mode      String          @default("plan_modifier")
  title     String          @default("New Chat")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIChatMessage[]

  @@index([userId, mode])
  @@index([userId, createdAt])
}

model AIChatMessage {
  id         String        @id @default(cuid())
  sessionId  String
  role       String
  content    String        @db.Text
  actionData Json?
  createdAt  DateTime      @default(now())

  session    AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
