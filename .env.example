# ==============================================================================
# ANTI-BURNOUT SAT TRACKER - ENVIRONMENT TEMPLATE
# ==============================================================================

# 1. DATABASE URL (Prisma connection string)
# e.g., postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# 2. ADMIN GMAIL
# Set this to your Google account email to receive automated ADMIN privileges
ADMIN_EMAIL="admin@gmail.com"

# 3. NEXTAUTH CONFIGURATION
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-32-byte-secret-here"

# 4. GOOGLE CLOUD OAUTH 2.0 CREDENTIALS
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# 5. GEMINI API KEY (Optional)
GEMINI_API_KEY=""
