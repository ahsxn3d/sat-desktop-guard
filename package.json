{
  "name": "sat-desktop-guard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start --port 3000",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "electron:dev": "concurrently -k \"cross-env PORT=3000 next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:start": "electron ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/postcss": "^4.1.14",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.19.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "postcss": "^8.4.49",
    "prisma": "^6.4.1",
    "typescript": "~5.8.2",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.js"
}
